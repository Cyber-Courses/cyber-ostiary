{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "echo '//npm.pkg.github.com/:_authToken=${NPM_TOKEN}' >> ~/.npmrc && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @ostiary/core db:migrate && pnpm --filter @ostiary/core db:seed && next build",
  "crons": [
    {
      "path": "/api/cron/webhooks",
      "schedule": "*/5 * * * *"
    }
  ]
}
